# Run pnpm setup to generate local secrets. Fill in the OMS values later.
ADMIN_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
OIDC_PRIVATE_JWK=
# Optional public keys published before/after issuer signing-key rotation.
OIDC_ADDITIONAL_PUBLIC_JWKS=
OIDC_ISSUER=
OIDC_AUDIENCE=api.dev.polygon-dev.technology
OMS_PUBLISHABLE_KEY=
# Comma-separated approved 48-byte PCR0 values for your selected environment.
TRUSTED_PCR0S=
APP_ORIGIN=http://127.0.0.1:5187
DATABASE_PATH=.data/dashboard.sqlite
# Trails swaps. Separate from OMS; never expose this key in UI config.
TRAILS_API_KEY=
TRAILS_API_URL=https://trails-api.sequence.app
TRAILS_PROJECT_ID=oms-dashboard
# Enable only for controlled acceptance, then normal use after recovery passes.
SWAPS_ENABLED=false
# Optional JSON object mapping chain IDs to dedicated HTTPS RPC URLs.
EVM_RPC_URLS={}
# Existing wallet address for optional quote-only checks (no transactions).
TRAILS_TEST_WALLET=
