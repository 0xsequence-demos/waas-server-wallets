{
  "name": "@polygonlabs/oms-server-wallet-sdk",
  "version": "0.1.0",
  "description": "Standalone TypeScript SDK for OMS server wallets, OIDC authentication, attested signing, and sponsored transfers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsequence-demos/waas-server-wallets.git",
    "directory": "packages/server-wallet-sdk"
  },
  "homepage": "https://github.com/0xsequence-demos/waas-server-wallets/blob/master/docs/NODE-INTEGRATION.md",
  "bugs": {
    "url": "https://github.com/0xsequence-demos/waas-server-wallets/issues"
  },
  "keywords": [
    "polygon",
    "oms",
    "wallet",
    "waas",
    "oidc",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE",
    "LICENSE-APACHE-2.0"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@peculiar/x509": "2.0.0",
    "cbor-x": "1.6.6",
    "reflect-metadata": "0.2.2",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
