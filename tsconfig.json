{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "vite/client"
    ],
    "paths": { "@polygonlabs/oms-server-wallet-sdk": ["./packages/server-wallet-sdk/src/index.ts"] }
  },
  "include": ["apps", "packages/*/src", "scripts", "tests", "*.ts", "worker-configuration.d.ts"]
}
